{
  "stack": "angular-only",
  "serves_http": false,
  "rules": {
    "governance.md": {
      "source": "governance.md",
      "vars": {
        "NIT_EXAMPLE": "Could simplify with optional chaining here.",
        "MANIFEST_FILES": "`package.json`",
        "AUDIT_COMMANDS": "`npm audit`",
        "VERSION_FILES": "`package.json`"
      }
    },
    "dev-level.md": {
      "source": "dev-level.md",
      "vars": {
        "DEV_LEVEL": "SENIOR",
        "JUNIOR_PITFALLS": "forgetting to unsubscribe from an Observable, mutating an `@Input()` directly",
        "FRAMEWORK_IDIOMS": "Angular decorators, RxJS operators",
        "IDIOMATIC_EXTRA": " RxJS operator chains are fine.",
        "RUNTIME_INTERNALS": "Angular internals, RxJS, and the browser runtime",
        "DOC_REFERENCES": "Angular documentation or RFCs",
        "ADVANCED_CONSTRUCTS": "generic types, custom RxJS operators, injection tokens"
      }
    },
    "security.md": {
      "from_policies": "security",
      "title": "Security Rules — Angular / TypeScript",
      "paths": [
        "src/**/*.ts",
        "src/**/*.html"
      ]
    },
    "architecture.md": {
      "from_policies": "architecture",
      "title": "Architecture Rules — Angular / TypeScript",
      "paths": [
        "src/**/*.ts",
        "src/**/*.html"
      ]
    },
    "frontend.md": {
      "own": true
    },
    "testing.md": {
      "own": true
    }
  },
  "adapters": {
    "copilot": [
      {
        "from_policies": "security",
        "title": "Security Rules — Angular / TypeScript",
        "paths": [
          "src/**/*.ts",
          "src/**/*.html"
        ],
        "out": ".github/instructions/security.instructions.md"
      },
      {
        "from_policies": "architecture",
        "title": "Architecture Rules — Angular / TypeScript",
        "paths": [
          "src/**/*.ts",
          "src/**/*.html"
        ],
        "out": ".github/instructions/architecture.instructions.md"
      }
    ]
  }
}
