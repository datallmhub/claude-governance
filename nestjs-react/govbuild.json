{
  "stack": "nestjs-react",
  "serves_http": true,
  "rules": {
    "governance.md": {
      "source": "governance.md",
      "vars": {
        "NIT_EXAMPLE": "Could simplify with optional chaining here.",
        "MANIFEST_FILES": "`package.json`",
        "AUDIT_COMMANDS": "`npm audit`",
        "VERSION_FILES": "root and workspace `package.json` files"
      }
    },
    "dev-level.md": {
      "source": "dev-level.md",
      "vars": {
        "DEV_LEVEL": "TECH_LEAD",
        "JUNIOR_PITFALLS": "forgetting `@Injectable()`, importing services across modules, mutating the query cache directly",
        "FRAMEWORK_IDIOMS": "NestJS decorators, React hooks",
        "IDIOMATIC_EXTRA": "",
        "RUNTIME_INTERNALS": "NestJS internals, TypeORM, and React",
        "DOC_REFERENCES": "NestJS documentation or RFCs",
        "ADVANCED_CONSTRUCTS": "custom decorators, dynamic modules, query key factories"
      }
    },
    "model-selection.md": {
      "source": "model-selection.md",
      "vars": {
        "LIGHT_TASKS": "Docs, renaming, simple syntax fixes",
        "SENSITIVE_AREAS": "entities, migrations, security, or multi-tenancy"
      }
    },
    "security.md": {
      "from_policies": "security",
      "title": "Security Rules — NestJS + React",
      "paths": [
        "backend/src/**/*.ts",
        "frontend/src/**/*.ts",
        "frontend/src/**/*.tsx",
        "infra/**/*"
      ]
    },
    "architecture.md": {
      "from_policies": "architecture",
      "title": "Architecture Rules — NestJS + React",
      "paths": [
        "backend/src/**/*.ts",
        "frontend/src/**/*.ts",
        "frontend/src/**/*.tsx",
        "infra/**/*"
      ]
    },
    "backend.md": {
      "own": true
    },
    "database.md": {
      "own": true
    },
    "frontend.md": {
      "own": true
    },
    "testing.md": {
      "own": true
    }
  },
  "adapters": {
    "copilot": [
      {
        "from_policies": "security",
        "title": "Security Rules — NestJS + React",
        "paths": [
          "backend/src/**/*.ts",
          "frontend/src/**/*.ts",
          "frontend/src/**/*.tsx",
          "infra/**/*"
        ],
        "out": ".github/instructions/security.instructions.md"
      },
      {
        "from_policies": "architecture",
        "title": "Architecture Rules — NestJS + React",
        "paths": [
          "backend/src/**/*.ts",
          "frontend/src/**/*.ts",
          "frontend/src/**/*.tsx",
          "infra/**/*"
        ],
        "out": ".github/instructions/architecture.instructions.md"
      }
    ]
  }
}
